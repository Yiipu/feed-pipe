# deploy/server.env.example — example env for running the feed-pipe pipeline
# on a bare-metal Linux server. Copy to server.env, fill in the placeholders,
# source before running:  set -a; . server.env; set +a

# OpenAI-compatible chat gateway
OPENAI_BASE_URL=http://<llm-gateway-host>:<port>/v1
# Read the real key from the gateway's config on the server; never commit it.
OPENAI_API_KEY=<your-key>

# Optional HTTP proxy for reaching rate-limited sources (e.g. Reddit) from the
# server; fetch_feed.sh passes it to curl -x. Leave unset for direct access.
FEED_PROXY=http://127.0.0.1:<proxy-port>

# Per-script models (falls back: MODEL_TRANSLATE/MODEL_SUMMARIZE -> MODEL -> default)
MODEL_TRANSLATE=<model>
MODEL_SUMMARIZE=<model>

# Cache location
XDG_CACHE_HOME=<home>/.cache
